# Vercel Production only, on main. Copy values into project settings.
APP_ENV=production
SITE_URL=

# Firebase Admin service account from the dedicated production Firebase project.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google sign-in. Use this Firebase project’s web app config.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Comma-separated Google account emails.
ADMIN_ALLOWED_EMAILS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set only after the client has configured the corresponding services.
MONO_TOKEN=
NOVA_POSHTA_API_KEY=

# Switch only after importing verified production catalogue data.
# CATALOG_SOURCE=firestore

# Server-only checkout rollout. Online payment needs the deployed public HTTPS SITE_URL.
CHECKOUT_ENABLED=false
# "test" requires a separately issued test token. "live" charges real money.
MONO_MODE=live
# Explicit controlled live payments on isolated DEV only; never run automated charges.
ALLOW_LIVE_PAYMENTS_IN_DEVELOPMENT=false
ORDER_EMAIL_ENABLED=false
# Production test product is hidden unless explicitly enabled for a controlled check.
TEST_PRODUCT_ENABLED=false
# Optional HTTP bearer secret for the private reconciliation job (at least 32 random characters).
CRON_SECRET=

# Must be independent of the site A record before the domain moves to Vercel.
SMTP_HOST=mail.caviar.net.ua
SMTP_PORT=465
SMTP_SECURE=true
# Dedicated sending mailbox created in cPanel — NOT the shared business inbox,
# so these credentials never grant access to customer correspondence.
# MAIL_FROM must equal SMTP_USER; the transport refuses anything else.
SMTP_USER=notify@caviar.net.ua
SMTP_PASSWORD=
MAIL_FROM=notify@caviar.net.ua
# The mailbox a human reads; every customer reply lands here.
MAIL_REPLY_TO=sale@caviar.net.ua
PROMOTION_EMAIL_ENABLED=false
PROMOTION_PUBLIC_ENABLED=false

# Comma-separated staff recipients; each address receives its own copy.
# Only addresses listed here can receive owner mail, so keep this in sync with the team.
OWNER_NOTIFICATION_EMAILS=sales@faic.com.ua,faic.caviar@gmail.com
OWNER_EMAIL_ENABLED=false
RESTOCK_EMAIL_ENABLED=false
