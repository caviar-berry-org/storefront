# Local: copy to .env.local. Vercel: dedicated DEV project, including its primary deployment.
APP_ENV=development
SITE_URL=http://localhost:3000

# Firebase Admin service account from the dedicated dev Firebase project.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Copy private_key from the service account JSON, preserving PEM newlines.
FIREBASE_PRIVATE_KEY=

# Google sign-in. Use this Firebase project’s web app config.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Comma-separated Google account emails.
ADMIN_ALLOWED_EMAILS=

# Dedicated development product environment. Leave blank to use local images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set only after test credentials have been issued.
MONO_TOKEN=
NOVA_POSHTA_API_KEY=

# HostPro SMTP connection check: npm run mail:verify. Does not send email.
# Development mailbox only. Keep the password in .env.local, never in Git.
SMTP_HOST=caviar.net.ua
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dev-notify@caviar.net.ua
SMTP_PASSWORD=
MAIL_FROM=dev-notify@caviar.net.ua
# Where customer replies go. Unset in DEV = replies return to the sender mailbox.
MAIL_REPLY_TO=
# Comma-separated controlled recipients for mail:test; public deliveries use their enable flags.
MAIL_TEST_RECIPIENTS=
# Enable the DEV promotion form only after SMTP verification and delivery checks.
PROMOTION_EMAIL_ENABLED=false
# Allow promo-form requests from any valid email; mail:test remains allowlisted.
PROMOTION_PUBLIC_ENABLED=false

# Switch the public storefront after importing the development catalogue.
# CATALOG_SOURCE=firestore

# Server-only checkout rollout. Online payment needs the deployed public HTTPS SITE_URL.
CHECKOUT_ENABLED=false
# "test" requires a separately issued test token. "live" charges real money.
MONO_MODE=live
# Explicit controlled live payments on isolated DEV only; never run automated charges.
ALLOW_LIVE_PAYMENTS_IN_DEVELOPMENT=false
ORDER_EMAIL_ENABLED=false
# Production test product is hidden unless explicitly enabled for a controlled check.
TEST_PRODUCT_ENABLED=false
# Optional HTTP bearer secret for the private reconciliation job (at least 32 random characters).
CRON_SECRET=

# Owner notifications: one private message per recipient. Separate addresses with commas.
OWNER_NOTIFICATION_EMAILS=
OWNER_EMAIL_ENABLED=false
# Automatic email when a requested product/pack returns to available stock.
RESTOCK_EMAIL_ENABLED=false
